# Private key of the deployer wallet (do NOT include 0x prefix or include it, standard 64 hex chars)
# NEVER commit your real private key to GitHub or public repositories
PRIVATE_KEY=your_private_key_here

# Botchain Mainnet RPC URL (Chain ID 677)
BOTCHAIN_RPC_URL=https://rpc.botchain.ai

# Optional: Next.js public contract address override
NEXT_PUBLIC_CONTRACT_ADDRESS=
